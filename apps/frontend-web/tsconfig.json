{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@game/types": ["../../libs/shared-types/src/index.ts"],
      "@game/types/*": ["../../libs/shared-types/src/*"],
      "@game/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@game/shared-types/*": ["../../libs/shared-types/src/*"],
      "@game/i18n": ["../../libs/i18n/index.ts"],
      "@game/ui": ["../../libs/ui/src/index.ts"],
      "@game/ui/*": ["../../libs/ui/src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
