    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-joi-validation": "^5.0.1",
    "express-rate-limit": "^7.0.0",
    "express-useragent": "^1.0.15",
    "fs-extra": "^11.2.0",
    "helmet": "^8.0.0",
    "http": "^0.0.1-security",
    "http-status": "^1.7.4",
    "image-size": "^2.0.2",
