  "name": "backend",
  "version": "1.0.0",
  "description": "87app backend — Express + MongoDB + Socket.io",
  "main": "dist/index.js",
  "license": "ISC",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
