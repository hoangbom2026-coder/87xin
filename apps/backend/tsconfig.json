{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "noImplicitAny": false,
        "strictNullChecks": false,
        "module": "commonjs",
        "esModuleInterop": true,
        "target": "es6",
        "moduleResolution": "node",
        "sourceMap": true,
        "outDir": "dist",
        "baseUrl": "src",
        "rootDir": "src",
        "paths": {
            "@main/*": [
                "main/*"
            ],
            "@utils/*": [
                "utils/*"
            ],
            "@config/*": [
                "config/*"
            ],
            "@middlewares/*": [
                "middlewares/*"
            ]
        },
        "lib": [
            "es2021"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "src/scripts",
        "dist"
    ]
}