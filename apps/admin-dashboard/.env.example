# Admin — sao chép sang .env / .env.local

# Base URL cho axios chính của admin: phải có suffix /api
# Production: https://api.cuocbong99.live/api
# Local: http://localhost:8701/api
VITE_BACKEND_URL=http://localhost:8701/api

# Host gốc dùng cho asset/redirect (không có /api)
VITE_HOST_API=http://localhost:8701
