# Frontend1 — sao chép sang .env / .env.local

# Realtime (Socket.IO) — cùng origin với site; Nginx proxy /socket.io → backend :8701
# Không dùng URL riêng trừ khi API subdomain: VITE_SOCKET_URL=https://api.cuocbong99.live

# ───────── API ─────────
# Cùng origin với Nginx (production) hoặc proxy của Vite (dev): để trống / "/api"
# Subdomain: https://api.cuocbong99.live/api
VITE_API_URL=/api

# Khi dùng Vite dev (yarn dev), nếu VITE_API_URL không phải URL tuyệt đối,
# request /api/* sẽ bị Vite proxy sang VITE_API_PROXY_TARGET (chỉ dev).
VITE_API_PROXY_TARGET=http://localhost:5000

# Base URL cho admin axios (chỉ cần khi UI gọi tới admin API host).
# Phải có suffix /api: vd https://admin.cuocbong99.live/api hoặc http://localhost:5001/api
VITE_ADMIN_URL=http://localhost:5001/api

# ───────── App ─────────
VITE_APP_TITLE=Cuocbong99
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=development
VITE_SITE_NAME=cuocbong99.live
VITE_LOGO_URL=/images/header/logo.png

VITE_PUBLIC_SITE_URL=https://cuocbong99.live
VITE_SUPPORT_EMAIL=support@cuocbong99.live
VITE_PRIVACY_EMAIL=privacy@cuocbong99.live
VITE_TELEGRAM_SUPPORT_URL=https://t.me/cuocbong99_support

VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MAINTENANCE_MODE=false

VITE_RECAPTCHA_SITE_KEY=
VITE_STRIPE_PUBLIC_KEY=

# Cổng dev/preview (tuỳ chọn)
VITE_DEV_PORT=3000
VITE_PREVIEW_PORT=4173
