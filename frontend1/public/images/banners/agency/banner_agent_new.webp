  </div>
  <div class="unavailable-country__content">
    <div class="unavailable-country__content-thumb">
      <img src="data:image/svg+xml;base64," alt="network" class="network">
    </div>
    <div class="unavailable-country__content-title">
      Không thể truy cập vào trang web do nội dung không khả dụng tại quốc gia
      sở tại.<br>
      Vui lòng liên hệ với chúng tôi để được hỗ trợ.
    </div>
    <div class="unavailable-country__content-desc">
      Unable to access our website due to content unavailability in your
      country.<br>
      Please contact us in case you need supports.
    </div>
    <div class="unavailable-country__content-button">
      <a href="https://lu88.com/#" id="live-chat-button"> LIVE CHAT </a>
    </div>
  </div>
</div>

<script type="text/javascript" defer="" src="https://cdn.livechatinc.com/tracking.js"></script><script>
  window.__lc = window.__lc || {};
  window.__lc.license = '18230724';
  window.__lc.group = 3;
  window.__lc.unique_groups = 1;
  window.__lc.chat_between_groups = false;
  window.__lc.integration_name = 'manual_channels';
  window.__lc.product_name = 'livechat';
  window.LC_API = window.LC_API || {};
  window.LC_API.on_after_load = () => {
    if (window.innerWidth <= 992) {
      const interval = setInterval(() => {
        if (window.LC_API.chat_window_minimized()) {
          window.LC_API.hide_chat_window();
          clearInterval(interval);
        }
      }, 100);
    }
  };
  (function () {
    const lc = document.createElement('script');
    lc.type = 'text/javascript';
    lc.defer = true;
    lc.src = `${
        document.location.protocol === 'https:' ? 'https://' : 'http://'
    }cdn.livechatinc.com/tracking.js`;
    const s = document.getElementsByTagName('script')[0];
    s.parentNode.insertBefore(lc, s);

    document.getElementById('live-chat-button').addEventListener('click', function (event) {
      event.preventDefault();
      if (typeof window.LC_API?.open_chat_window === 'function') {
        console.log('window.LC_API:', window.LC_API);
        window.LC_API.open_chat_window();
        document.getElementById('chat-widget-container').style.display =
          'block';
        return;
      }
      const width = 440;
      const height = 750;

      const leftPosition = window.screen.width / 2 - (width / 2 + 10);
      const topPosition = window.screen.height / 2 - (height / 2 + 50);
      const directLink = `https://secure.livechatinc.com/licence/${window.__lc.license}/v2/open_chat.cgi?group=${window.__lc.group}&unique_groups=1`;
      window.open(
        directLink,
        'Window2',
        'status=no,height=' +
          height +
          ',width=' +
          width +
          ',resizable=yes,left=' +
          leftPosition +
          ',top=' +
          topPosition +
          ',screenX=' +
          leftPosition +
          ',screenY=' +
          topPosition +
          ',toolbar=no,menubar=no,scrollbars=no,location=no,directories=no'
      );
    });
  })();
</script>
