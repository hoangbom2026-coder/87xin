<!DOCTYPE html>
<!-- saved from url=(0018)https://lu88.com/ -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Unavailable Country</title>
<meta name="viewport" content="width=device-width,initial-scale=1">

  <title>Unavailable Country</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz@14..32&amp;display=swap" rel="stylesheet">
  <style>
    body {
      font-family: "Inter", sans-serif;
      margin: 0;
      font-size: 16px;
      line-height: 24px;
      font-weight: 400;
      color: #6a778b;
    }

    .unavailable-country__logo {
      padding: 14.5px 0;
      text-align: center;
      background: #00432a;
    }

    .unavailable-country__logo img {
      height: 32px;
    }

    .unavailable-country__content {
      background: url("data:image/jpeg;base64,") no-repeat center center;
      background-size: cover;
      height: calc(100vh - 72px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
      text-align: center;
    }

    .unavailable-country__content-thumb {
      margin-top: 76px;
    }

    .unavailable-country__content-thumb img {
      width: 286px;
    }

    .unavailable-country__content-button a {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #ffda55;
      color: #185745;
      font-weight: 700;
      padding: 10px 0;
      border-radius: 8px;
      text-decoration: none;
      width: 117px;
    }

    @media screen and (max-width: 768px) {
      body {
        font-size: 14px;
        line-height: 20px;
        height: 100dvh;
      }

      .unavailable-country {
        height: 100%;
      }

      .unavailable-country__logo {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 17px 0;
      }

      .unavailable-country__content-thumb {
        margin-top: 0;
      }

      .unavailable-country__logo img {
        height: 22px;
      }

      .unavailable-country__content {
        height: calc(100% - 56px);
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 18px;
        padding: 0 12px;
      }

      .unavailable-country__content-thumb img {
        width: 160px;
      }

      .unavailable-country__content-button a {
        width: 106px;
        font-size: 14px;
        line-height: 20px;
        font-weight: 600;
        border-radius: 8px;
        margin-top: 5px;
      }
    }

    @media screen and (max-height: 460px) {
      .unavailable-country__content {
        padding: 12px;
      }
    }
  </style>
</head>
