[Unit]
Description=TC-Gaming Swap File Setup (2GB)
Documentation=https://github.com/tc-gaming/infra
After=local-fs.target
Before=swap.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Tạo swap file 2GB nếu chưa tồn tại
ExecStart=/bin/bash -c '\
  if [ ! -f /swapfile ]; then \
    echo "Creating 2GB swapfile..."; \
    dd if=/dev/zero of=/swapfile bs=1M count=2048 status=progress; \
    chmod 600 /swapfile; \
    mkswap /swapfile; \
    echo "Swapfile created."; \
  else \
    echo "Swapfile already exists, skipping creation."; \
  fi'

# Bật swap
ExecStart=/bin/bash -c '\
  if ! swapon --show | grep -q /swapfile; then \
    swapon /swapfile; \
    echo "Swapfile activated."; \
  else \
    echo "Swapfile already active."; \
  fi'

# Cấu hình tham số kernel tối ưu cho VPS 4CPU/8GB
# swappiness=10: chỉ swap khi RAM còn <10% — tránh swap liên tục làm chậm I/O
# vfs_cache_pressure=50: giữ inode/dentry cache lâu hơn mặc định (100)
ExecStart=/bin/bash -c '\
  sysctl -w vm.swappiness=10; \
  sysctl -w vm.vfs_cache_pressure=50; \
  echo "vm.swappiness=10" >> /etc/sysctl.d/99-tc-gaming.conf; \
  echo "vm.vfs_cache_pressure=50" >> /etc/sysctl.d/99-tc-gaming.conf; \
  sysctl -p /etc/sysctl.d/99-tc-gaming.conf; \
  echo "Kernel parameters set."'

# Thêm vào /etc/fstab nếu chưa có (để tự bật khi reboot)
ExecStart=/bin/bash -c '\
  if ! grep -q /swapfile /etc/fstab; then \
    echo "/swapfile none swap sw 0 0" >> /etc/fstab; \
    echo "Added swapfile to /etc/fstab."; \
  fi'

ExecStop=/bin/bash -c 'swapoff /swapfile 2>/dev/null || true'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tc-gaming-swap

[Install]
WantedBy=multi-user.target
