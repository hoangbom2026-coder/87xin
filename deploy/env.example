# Sao chép thành env.local và chỉnh trước khi deploy:
#   cp /var/87app/deploy/env.example /var/87app/deploy/env.local
#
# deploy.sh sẽ "source" env.local trước khi build frontend (biến VITE_*)

# --- DNS / public URLs ---
DOMAIN=cuocbong99.live
# API công khai (phải khớp DNS api.<DOMAIN>)
PUBLIC_API_ORIGIN=https://api.cuocbong99.live

# --- Build frontend (Vite) ---
# Cùng origin (Nginx /api → backend): VITE_API_URL=/api (xem DEPLOY.md).
# Hoặc subdomain API (build gọi thẳng api.*):
export VITE_HOST_API=https://api.cuocbong99.live
export VITE_API_URL=https://api.cuocbong99.live/api
export VITE_SOCKET_URL=https://api.cuocbong99.live

# Host header cho vite preview (cách nhau bởi dấu phẩy)
export VITE_PREVIEW_ALLOWED_HOSTS=cuocbong99.live,www.cuocbong99.live,localhost,127.0.0.1
export VITE_PREVIEW_PORT=8710

# --- Admin preview ---
export ADMIN_PREVIEW_PORT=8712
export VITE_ADMIN_ALLOWED_HOSTS=admin.cuocbong99.live,www.admin.cuocbong99.live,localhost,127.0.0.1

# --- Backend: PM2 đặt PORT=8701 (xem ecosystem.config.cjs), không cần đổi .env để tránh trùng mbs-backend:5000 ---
# Trong backend/.env vẫn cần đủ biến (DATABASE_URL, JWT_*, ...)
# DATABASE_URL=...
# (toàn bộ biến backend xem backend/src/config/index.ts)
