# Copy to the environment file required by the target app and replace placeholders.
# Never put production secrets in this file.

NODE_ENV=development
SITE_DOMAIN=localhost
ADMIN_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8701
CORS_ORIGIN=http://localhost:3000,http://localhost:8781
PORT=8701
ADMIN_PREVIEW_PORT=8781

DATABASE_URL=mongodb://127.0.0.1:27017/tc-gaming
JWT_SECRET=change_me_with_a_random_secret

# Optional integrations
# REDIS_URL=redis://127.0.0.1:6379
# GSC_OP_CODE=change_me
# GSC_SECRET_KEY=change_me
# GSC_ENV=sandbox
# AG_HOST=https://api.ag.com
# AG_MERCHANT_CODE=change_me
# AG_SECRET_KEY=change_me

ADMIN_DEFAULT_PASSWORD=change_me_immediately
LOG_LEVEL=debug
SESSION_TTL_MINUTES=1440
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Optional notifications and email
# TELEGRAM_BOT_TOKEN=change_me
# TELEGRAM_CHAT_ID=change_me
# SENDGRID_API_KEY=change_me